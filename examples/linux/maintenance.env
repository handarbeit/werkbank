# Overrides for maintenance/host-maintenance.sh on a dedicated Linux box (sourced; bash syntax).
# Install: werkbank/maintenance/install-systemd.sh /path/to/deployment   (docs/linux-host.md)
DISKS="/ /srv/ci-disk"   # the OS drive, and the data drive behind /var/lib/docker and /var/lib/containerd
CACHE_MAX_GB=30          # daily: wipe the shared cache volume past this (room to spare on a big data drive)
# WARN_GB=15             # alert (to the journal) below this many GB free
# STOP_GB=5              # stop the runners below this
# START_GB=10            # restart them (if the watchdog stopped them) at this
# IMAGE=werkbank-runner:local   # the runner image tag, if not WERKBANK_IMAGE in .env
# OVERFLOW_CONFIG=/path/to/overflow.json # default: overflow.json in the deployment directory
