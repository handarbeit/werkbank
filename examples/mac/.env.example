# Copy to .env (mode 600). Never commit it.
#
# The org's GitHub App private key, on one line with newlines as \n, in double quotes
# (docs/github-app.md shows a one-line command that writes it). Its App ID goes in compose.yml
# and overflow.json; it isn't secret.
MY_APP_KEY=
# Repo-level runners outside the org: a fine-grained PAT on those repos, repository permission
# "Administration: read and write" (what runner registration needs).
PERSONAL_TOKEN=
# Optional: the runner image tag (default werkbank-runner:local).
# WERKBANK_IMAGE=werkbank-runner:local
