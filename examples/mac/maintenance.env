# Optional overrides for maintenance/host-maintenance.sh (sourced; bash syntax).
# WARN_GB=15             # notify below this many GB free
# STOP_GB=5              # stop the Linux runners below this
# START_GB=10            # restart them (if the watchdog stopped them) at this
# CACHE_MAX_GB=12        # daily: wipe the shared cache volume past this
# SNAPSHOT_KEEP_HOURS=2  # macOS: keep only this many hours of Time Machine local snapshots
# IMAGE=werkbank-runner:local   # the runner image tag, if not WERKBANK_IMAGE in .env
# CACHE_VOLUME=myproject_runner-caches   # if the compose project name isn't the directory's name
# OVERFLOW_CONFIG=/path/to/overflow.json # default: overflow.json in the deployment directory
